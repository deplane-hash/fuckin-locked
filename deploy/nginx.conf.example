# Replace the host and certificate paths. Do not expose the Python listener publicly.
server {
    listen 443 ssl http2;
    server_name REPLACE_WITH_GATEWAY_HOST;
    ssl_certificate /etc/letsencrypt/live/REPLACE_WITH_GATEWAY_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_GATEWAY_HOST/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log off;
    error_log /var/log/nginx/fuckin-locked-error.log warn;
    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }
}
