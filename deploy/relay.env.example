FL_DB=/var/lib/fuckin-locked/relay.sqlite3
FL_PORT=8787
# Generate locally with a CSPRNG. Remove after first device bootstrap.
FL_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
# Base64 of 32 random bytes. Back this up securely; losing it loses member metadata.
FL_METADATA_KEY=REPLACE_WITH_BASE64_RANDOM_32_BYTES
# Calls are disabled unless both values are set. Use TURN-over-TLS on the
# same host used by the HTTPS gateway (the client rejects a different host).
# The client enforces relay-only ICE and has no direct/STUN fallback. Generate
# one shared secret for coturn and this relay; the API mints expiring credentials.
FL_TURN_URL=turns:freedomhub.at:5349?transport=tcp
FL_TURN_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_ENCODED_AS_HEX
