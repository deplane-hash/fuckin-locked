# Protected service environment entries. No message/preview customization exists.
# Key owner: the fuckinlocked service user; mode 0600, no symlink.
FL_APNS_TEAM_ID=REPLACE_WITH_10_CHARACTER_APPLE_TEAM_ID
FL_APNS_KEY_ID=REPLACE_WITH_10_CHARACTER_APNS_KEY_ID
FL_APNS_KEY_PATH=/etc/fuckin-locked/REPLACE_WITH_APNS_AUTH_KEY.p8
FL_APNS_TOPIC=REPLACE_WITH_EXACT_SIGNED_APP_BUNDLE_IDENTIFIER
# Must match the provisioning profile: production or development.
FL_APNS_ENVIRONMENT=REPLACE_WITH_PROVISIONING_ENVIRONMENT
