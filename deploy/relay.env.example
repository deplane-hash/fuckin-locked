FL_DB=/var/lib/fuckin-locked/relay.sqlite3
FL_PORT=8787
# Generate locally with a CSPRNG. Remove after first device bootstrap.
FL_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
# Base64 of 32 random bytes. Back this up securely; losing it loses member metadata.
FL_METADATA_KEY=REPLACE_WITH_BASE64_RANDOM_32_BYTES
# Calls are disabled unless all three values are set. Use TURN-over-TLS;
# the client enforces relay-only ICE and has no direct/STUN fallback.
FL_TURN_URL=turns:turn.example.invalid:5349?transport=tcp
FL_TURN_USERNAME=REPLACE_WITH_SHORT_LIVED_USERNAME
FL_TURN_CREDENTIAL=REPLACE_WITH_SHORT_LIVED_CREDENTIAL
